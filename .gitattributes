# The original game's text files as it shipped them - CRLF - on every checkout.
# They are LF in the repository (committed with text=auto; see the catch-all
# below). A Windows checkout turned them back into the shipped bytes; a macOS
# or Linux clone left them LF, and test_pn_formats' round trips (the 0.7.12
# writer must give back the shipped bytes, CRLF included) failed there - first
# measured on the apple-port macOS runner, 14 failures. First in the file, so
# the *.txt rule below still decides the readme.txt files, as it does on
# Windows.
extracted/** eol=crlf

# Batch files MUST be CRLF or cmd.exe mis-parses them (a LF .bat makes `@echo off`
# fail and comment lines execute as commands). Everything we write stays LF.
*.bat   text eol=crlf
*.cmd   text eol=crlf

*.cpp   text eol=lf
*.hpp   text eol=lf
*.h     text eol=lf
*.txt   text eol=lf
*.cmake text eol=lf
*.json  text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.glsl  text eol=lf
*.vert  text eol=lf
*.frag  text eol=lf

.gitignore     text eol=lf
.gitattributes text eol=lf
.gitmodules    text eol=lf

# The original game under extracted/ was committed with text=auto, so its
# scripts and scenes are LF in the repository and CRLF in a Windows checkout.
# The port's readers accept both; they are Latin-1, not UTF-8.
*       text=auto

# After the catch-all, so these win over its text=auto. A shell script must be
# LF on every checkout (bash in WSL reads a CR as part of the command), and a
# font is bytes, never text.
*.sh    text eol=lf
*.mm    text eol=lf
*.plist text eol=lf
*.yml   text eol=lf
*.ttf   binary
