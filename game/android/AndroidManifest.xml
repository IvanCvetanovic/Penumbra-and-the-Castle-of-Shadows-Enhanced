<?xml version="1.0" encoding="utf-8"?>
<!--
    Penumbra on Android: the engine's SupersonicActivity, a NativeActivity with a
    few lines of Java for what only the UI thread may do - hiding the system
    bars and reporting the window's safe area (engine/src/platform/android/java/,
    compiled into classes.dex by tools/build_android.sh). The platform loads
    libPenumbra.so (android.app.lib_name), whose android_main is the engine's
    (engine/src/platform/android/AndroidApp.cpp).

    minSdk 26 is where AAudio begins; the engine also needs a Vulkan 1.2 device,
    which it checks at start (VulkanDevice::isDeviceSuitable). Landscape only,
    and every configuration change handled in place, because a NativeActivity
    that is recreated starts its native thread again over a running game.

    The launcher icon, @mipmap/ic_launcher, is an adaptive icon
    (tools/android_package.py writes it from the original's penumbra.ico:
    res/mipmap-anydpi-v26/ic_launcher.xml, a deep-violet gradient background,
    a foreground layer, and a monochrome one for Android 13's themed icons),
    so a launcher masks the skull on its tile: a plain square PNG alone is put
    on a white plate, and a transparent background is drawn as black, the
    system composing the layers over black. There is no android:roundIcon; a launcher
    that wants a round icon masks this one.

    tools/build_android.sh links this with aapt2 and signs the APK: by default
    in debug mode (debuggable, so run-as works) with the debug keystore; with
    release not debuggable, with the release key (the build_android.sh flag).
    versionName is the release's, the top-level CMakeLists.txt project VERSION
    (tools/make_release.py checks they agree); versionCode goes up by one with
    every release, or Android refuses the update.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ivancvetanovic.penumbra"
    android:versionCode="4"
    android:versionName="1.0.3">

    <uses-feature android:name="android.hardware.vulkan.level" android:version="0" android:required="true" />
    <uses-feature android:name="android.hardware.vulkan.version" android:version="0x402000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />

    <application
        android:label="Penumbra"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:appCategory="game"
        android:isGame="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <activity
            android:name="com.ivancvetanovic.supersonic.SupersonicActivity"
            android:label="Penumbra"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale|touchscreen|colorMode">

            <meta-data android:name="android.app.lib_name" android:value="Penumbra" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
