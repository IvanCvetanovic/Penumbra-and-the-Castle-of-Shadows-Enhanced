// The Windows resources of every executable this repository builds (the game
// and each suite, through penumbra_windows_resources in the top-level
// CMakeLists.txt): its icon (the original's own, read from
// extracted/app at build time) and version information. The application
// manifest is Penumbra.manifest, merged by the linker (CMake passes a listed
// .manifest as /MANIFESTINPUT).
//
// Beyond looking like a real application in Explorer, these matter on a
// machine running Smart App Control, which judges an unsigned executable by
// what it looks like when it has no reputation yet.

#include <winver.h>

1 ICON "@PENUMBRA_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ivan Cvetanovic"
            VALUE "FileDescription", "@PENUMBRA_RC_DESCRIPTION@"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "@PENUMBRA_RC_NAME@"
            VALUE "LegalCopyright", "Original game (c) Andre Santee / Asantee; enhanced edition by Ivan Cvetanovic"
            VALUE "OriginalFilename", "@PENUMBRA_RC_NAME@.exe"
            VALUE "ProductName", "Penumbra e o Castelo das Sombras - Enhanced"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
